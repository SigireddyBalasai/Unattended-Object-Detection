name: "rtdetr"
platform: "onnxruntime_onnx"
max_batch_size: 0
default_model_filename: "model.onnx"

parameters [
  {
    key: "intra_op_thread_count"
    value: { string_value: "1" }
  },
  {
    key: "inter_op_thread_count"
    value: { string_value: "1" }
  }
]

input [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [ 1, 3, 640, 640 ]
  }
]

output [
  {
    name: "output0"
    data_type: TYPE_FP32
    dims: [ 1, 300, 84 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]
